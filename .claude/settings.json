{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(//Users/mohamedghaly/projects/my-portfolio/**)"
    ],
    "ask": [
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-server-secrets.sh\"",
            "timeout": 10,
            "statusMessage": "Scanning for server secrets"
          }
        ]
      }
    ]
  }
}
